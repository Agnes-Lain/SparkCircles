# Copy to .env.local (git-ignored) and set the API address the app should call.
# EXPO_PUBLIC_ values are built into the app: never put a secret here.
#
# iPhone with Expo Go (same Wi-Fi as the Mac): the Mac's Wi-Fi address, found with
#   ipconfig getifaddr en0
# and the API started with `bin/rails server -b 0.0.0.0`.
EXPO_PUBLIC_API_URL=http://192.168.1.77:3000
#
# Android emulator on the Mac: 10.0.2.2 is the emulator's name for the Mac.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
