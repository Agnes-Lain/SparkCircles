<% user = @verification.user %>
<p><%= target_link "← Verifications", admin_verifications_path %></p>
<div class="title-row">
  <h1><%= user.display_name %></h1>
  <% if @verification.renewal? %><span class="badge badge-yellow">Renewal</span><% end %>
</div>
<p class="caption"><%= admin_icon(:lock, size: 14) %> Your access is recorded: verification review.</p>

<% if @reject_error %>
  <div class="notification notification-error" role="alert"><%= admin_icon(:alert_circle) %> <span>Not sent: <%= @reject_error %></span></div>
<% end %>

<div class="review">
  <div class="tiles">
    <% if @verification.files_available? %>
      <% { document_front: "Front", document_back: "Back", selfie: "Selfie" }.each do |name, label| %>
        <% next if name == :document_back && !@verification.double_sided? %>
        <div class="card tile">
          <p class="label"><%= label %></p>
          <a href="<%= file_admin_verification_path(@verification, file: name) %>" target="_blank" rel="noopener" class="link-target">
            <img src="<%= file_admin_verification_path(@verification, file: name) %>" alt="<%= label %> submitted by <%= user.display_name %>. Opens full size.">
          </a>
        </div>
      <% end %>
    <% else %>
      <div class="card"><p>The images were erased 30 days after the decision.</p></div>
    <% end %>
  </div>

  <div class="card">
    <dl>
      <dt>Name on the account</dt><dd><%= user.first_name %> <%= user.last_name %></dd>
      <dt>Date of birth</dt><dd><%= admin_date(user.date_of_birth) %></dd>
      <dt>Document</dt><dd><%= document_type_label(@verification.document_type) %></dd>
    </dl>
    <% if @verification.pending? %>
      <%= form_with url: approve_admin_verification_path(@verification), method: :post do |f| %>
        <div class="field <%= 'field-error' if @expiry_error %>">
          <%= f.label :document_expires_on, "Document expiry date" %>
          <%= f.date_field :document_expires_on, id: "document_expires_on", required: true, value: params[:document_expires_on],
                           "aria-describedby": [ ("expiry-error" if @expiry_error), "expiry-help" ].compact.join(" ") %>
          <% if @expiry_error %><%= render "admin/shared/field_error", id: "expiry-error", message: @expiry_error %><% end %>
          <% cap = Date.current + Verification::MAX_VALIDITY %>
          <span class="caption" id="expiry-help">Verification will be valid until
            <output id="validity-until" data-cap="<%= cap.iso8601 %>"><%= admin_date(cap) %> at most (2 years), or the document's expiry date if it comes first</output>.</span>
        </div>
        <div class="actions">
          <%= f.submit "Approve", class: "btn btn-primary" %>
          <button type="button" class="btn btn-ghost" data-dialog-open="reject-dialog">Not accepted</button>
        </div>
      <% end %>
    <% else %>
      <p><span class="badge badge-neutral"><%= @verification.status.humanize %></span> on <%= admin_date(@verification.decided_at) %></p>
    <% end %>
  </div>
</div>

<% if @verification.pending? %>
  <dialog class="modal" id="reject-dialog" aria-labelledby="reject-title" data-open-on-load="<%= @reject_error.present? %>">
    <div class="card">
      <h2 id="reject-title">Why isn't it accepted?</h2>
      <%= form_with url: reject_admin_verification_path(@verification), method: :post do |f| %>
        <fieldset style="border: 0; padding: 0; margin: 0 0 16px" <%= 'aria-describedby="reject-error"'.html_safe if @reject_error %>>
          <legend class="visually-hidden">Reason</legend>
          <% Verification::REJECTION_REASONS.each do |reason| %>
            <label class="radio">
              <%= f.radio_button :rejection_reason, reason, required: true %>
              <span><%= t("verification.rejection_reasons.#{reason}", locale: :en) %><br>
                <span class="caption"><%= t("verification.rejection_messages.#{reason}", locale: :en) %></span></span>
            </label>
          <% end %>
          <% if @reject_error %><%= render "admin/shared/field_error", id: "reject-error", message: @reject_error %><% end %>
        </fieldset>
        <div class="field">
          <%= f.label :note, "Note for the parent (optional)" %>
          <%= f.text_area :note, rows: 3, maxlength: 500, value: params[:note] %>
        </div>
        <div class="actions">
          <%= f.submit "Send", class: "btn btn-primary" %>
          <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
        </div>
      <% end %>
    </div>
  </dialog>
<% end %>
