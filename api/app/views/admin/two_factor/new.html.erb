<div class="card centered">
  <span class="logo"><%= render "admin/shared/logo" %></span>
  <h2>Confirm it's you</h2>
  <p>Enter the 6-digit code from your authenticator app.</p>
  <%= form_with url: admin_two_factor_path, method: :post do |f| %>
    <div class="field <%= 'field-error' if @code_error %>">
      <%= f.label :code, "Code" %>
      <%= f.text_field :code, inputmode: "numeric", autocomplete: "one-time-code", required: true, autofocus: true,
                       "aria-describedby": [ ("code-error" if @code_error), "code-help" ].compact.join(" ") %>
      <% if @code_error %><%= render "admin/shared/field_error", id: "code-error", message: @code_error %><% end %>
      <span class="caption" id="code-help">Lost your phone? Use one of your backup codes.</span>
    </div>
    <%= f.submit "Confirm", class: "btn btn-primary" %>
  <% end %>
</div>
