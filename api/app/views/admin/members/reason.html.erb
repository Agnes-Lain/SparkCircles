<p><%= target_link "← Members", admin_members_path %></p>
<div class="card centered">
  <h2>Before you open this member</h2>
  <%= form_with url: admin_member_path(@member), method: :get do |f| %>
    <%= render "admin/members/reason_fields" %>
    <%= f.submit "Continue", class: "btn btn-primary" %>
  <% end %>
</div>
