<div class="card centered">
  <span class="logo"><%= render "admin/shared/logo" %></span>
  <h2>Connect your authenticator app</h2>
  <p>Admins confirm every login with a 6-digit code. Scan this QR code with your authenticator app.</p>
  <div class="qr" role="img" aria-label="QR code to add SparkCircles admin to your authenticator app"><%= @qr_svg.html_safe %></div>
  <p class="caption">Can't scan? Type this key in the app:</p>
  <p class="codes" style="columns: 1"><%= @secret.scan(/.{1,4}/).join(" ") %></p>
  <p class="caption">On this phone? <%= target_link "Add to authenticator", @provisioning_uri %></p>
  <%= form_with url: admin_two_factor_setup_path, method: :post do |f| %>
    <div class="field <%= 'field-error' if @code_error %>">
      <%= f.label :code, "Code shown in the app" %>
      <%= f.text_field :code, inputmode: "numeric", autocomplete: "one-time-code", required: true,
                       "aria-describedby": ("code-error" if @code_error) %>
      <% if @code_error %><%= render "admin/shared/field_error", id: "code-error", message: @code_error %><% end %>
    </div>
    <%= f.submit "Confirm", class: "btn btn-primary" %>
  <% end %>
</div>
