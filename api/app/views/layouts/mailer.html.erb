<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { background: #F8F7F4; color: #1A1A1A; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 14px; line-height: 1.5; }
      .card { background: #FFFFFF; border-radius: 16px; max-width: 520px; margin: 24px auto; padding: 24px; }
      .wordmark { font-size: 20px; font-weight: 500; margin: 0 0 16px; }
      a { color: #2F7A1F; }
      a.button { display: inline-block; background: #A5E07F; color: #1A1A1A; text-decoration: none; font-weight: 500; padding: 14px 28px; border-radius: 999px; }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="wordmark">SPARKCIRCLES</p>
      <%= yield %>
    </div>
  </body>
</html>
